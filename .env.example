GATEWAY_API_KEY=your_gateway_api_key_here
GATEWAY_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# --- DB (기획서 15.3) ---
# docker-compose.yml 기준 기본값
DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix

# --- 인증 / JWT (기획서 15.2) ---
# 강한 랜덤 값 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_too
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Google Cloud Console에 등록할 콜백 URL과 동일해야 함
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# 로그인 완료 후 프론트로 돌려보낼 주소
FRONTEND_URL=http://localhost:5173

# --- 보안 (Phase F) ---
# HTTPS 운영 시 true (쿠키 Secure 플래그). 로컬 http에서는 false
COOKIE_SECURE=false
# CORS 허용 출처 (쉼표 구분). 운영 시 실제 도메인으로 제한
ALLOWED_ORIGINS=http://localhost:5173

# --- 답변 캐싱 (기획서 15.4) ---
# Gateway에 embeddings 미지원 → fastembed 로컬 ONNX 모델 사용 (한국어 포함 다국어, 384차원)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# near-duplicate만 적중시키는 보수적 임계값 (낮출수록 의미유사 적중↑, 오탐↑)
CACHE_SIMILARITY_THRESHOLD=0.9
# 메모리 적은 무료 호스트(예: 512MB)에서는 false로 두면 임베딩 모델을 안 띄움(캐시 비활성)
CACHE_ENABLED=true
